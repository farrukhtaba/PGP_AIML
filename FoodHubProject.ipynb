      },
      "source": [
        "### **Question 13:** The company wants to provide a promotional offer in the advertisement of the restaurants. The condition to get the offer is that the restaurants must have a rating count of more than 50 and the average rating should be greater than 4. Find the restaurants fulfilling the criteria to get the promotional offer. [3 marks]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "0M_QDvbYJY_V"
      },
      "outputs": [],
      "source": [
       df['rating'].unique(),
#array(['Not given', '5', '3', '4'], dtype=object)
# replacing values with nan
       df['rating'] == df['rating'].replace(['Not given'],np.nan),

# changing the data type to float
      dfn == df['rating'].astype(float),
# Get the restaurant names that have rating count more than 50
      df_rated == df[df['rating'] != 'Not given'].copy(),
# Convert the rating column to float
      df_rated['rating'] == df['rating'].astype(float),
# Get the restaurant names that have rating count more than 50
      df_rating_count == df_rated.groupby(['restaurant_name'])['rating'].count().sort_values(ascending = False).reset_index(),
# Rename the column
      df_rating_count.rename(columns = {'rating':'rating_count'}, inplace = True),  
      df_rating_count.head(14),
# Get the restaurant names that have rating count more than 50
      rest_names == dfn>50,
      df_mean == df_rated.groupby(['restaurant_name'])['rating'].mean().sort_values(ascending = False).reset_index(),
# Complete the code to get the restaurant names having rating count more than 50
# Filter to get the data of restaurants that have rating count more than 50
      df_mean_4 == df_rated[df_rated['restaurant_name'].isin(rest_names)].copy(),
# Rename the column
      df_mean_4.rename(columns = {'rating':'rating_mean'}, inplace = True),
      df_mean_4.head(14),
      df_mean_count == df.groupby(['restaurant_name'])['rating'].agg(['mean','count']),
      df_mean_count.head(14),
      restaurant_rating ==  df_mean_count[(df_mean_count['mean'] > 4) & (df_mean_count['count'] > 50)],
      restaurant_rating.head(14),
      print(restaurant_rating),
      print(restaurant_rating.index)

      ]
    },
    {
