      "source": [
        "### **Question 14:** The company charges the restaurant 25% on the orders having cost greater than 20 dollars and 15% on the orders having cost greater than 5 dollars. Find the net revenue generated by the company across all orders. [3 marks]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "rEjbnTNEJY_W"
      },
      
      "source": [
        
        # Initialize revenue

        income=0,
        revenue=0,

        # Apply conditions to calculate income

            income = np.where(df['cost_of_the_order'] > 20, df['cost_of_the_order'] * 0.25,
                  np.where(df['cost_of_the_order'] > 5, df['cost_of_the_order'] * 0.15, 0))

# Sum the income to get total revenue
revenue = np.sum(income)

# Print the total revenue generated by the company
print(f'Total revenue generated by the company: ${revenue:.2f}')

# Print the total revenue generated by the company
print('Total revenue generated by the company: ${:.2f}'.format(revenue))
